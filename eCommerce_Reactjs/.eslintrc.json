{
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },
  "extends": ["react-app", "react-app/jest"],
  "rules": {
    "no-unused-vars": "warn",
    "eqeqeq": "warn",
    "jsx-a11y/anchor-is-valid": "warn",
    "no-useless-computed-key": "warn",
    "react-hooks/exhaustive-deps": "warn"
  },
  "ignorePatterns": ["src/resources/", "public/resources/", "node_modules/", "build/"]
}
