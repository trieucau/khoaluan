{
  "env": {
    "node": true,
    "es2022": true
  },
  "extends": ["eslint:recommended", "prettier"],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "no-unused-vars": "warn",
    "no-console": "warn",
    "no-async-promise-executor": "warn",
    "no-undef": "error",
    "no-redeclare": "error",
    "no-unreachable": "error",
    "no-prototype-builtins": "warn"
  }
}
